{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wortwerk.dev/schema/story.schema.json",
  "title": "WortwerkCompiledStory",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "title",
    "lang",
    "glossLang",
    "level",
    "wordCount",
    "sentences",
    "lexicon"
  ],
  "properties": {
    "schemaVersion": {
      "type": "integer",
      "minimum": 1,
      "const": 1
    },
    "id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "lang": { "type": "string", "minLength": 2 },
    "glossLang": { "type": "string", "minLength": 2 },
    "level": { "type": "string", "minLength": 1 },
    "wordCount": { "type": "integer", "minimum": 0 },
    "sentences": {
      "type": "array",
      "items": { "$ref": "#/$defs/sentence" }
    },
    "lexicon": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/lexiconEntry" }
    }
  },
  "$defs": {
    "token": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text", "space"],
      "properties": {
        "id": { "type": "integer", "minimum": 0 },
        "text": { "type": "string" },
        "space": { "type": "boolean" }
      }
    },
    "unit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens", "lex"],
      "properties": {
        "tokens": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0 },
          "minItems": 1,
          "uniqueItems": true
        },
        "lex": { "type": "string", "minLength": 1 },
        "form": { "type": "string", "minLength": 1 },
        "gloss": { "type": "string", "minLength": 1 }
      }
    },
    "sentence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "p", "tokens", "units", "translation"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "p": { "type": "integer", "minimum": 0 },
        "tokens": {
          "type": "array",
          "items": { "$ref": "#/$defs/token" },
          "minItems": 1
        },
        "units": {
          "type": "array",
          "items": { "$ref": "#/$defs/unit" }
        },
        "translation": { "type": "string", "minLength": 1 }
      }
    },
    "separable": {
      "type": "object",
      "additionalProperties": false,
      "required": ["prefix", "stem"],
      "properties": {
        "prefix": { "type": "string" },
        "stem": { "type": "string" }
      }
    },
    "lexiconEntry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["lemma", "kind", "pos", "meaning"],
      "properties": {
        "lemma": { "type": "string", "minLength": 1 },
        "kind": {
          "type": "string",
          "enum": ["word", "phrase", "separable", "compound", "name"]
        },
        "pos": { "type": "string", "minLength": 1 },
        "meaning": { "type": "string", "minLength": 1, "maxLength": 120 },
        "gender": { "type": "string", "enum": ["m", "f", "n"] },
        "article": { "type": "string", "minLength": 1 },
        "plural": { "type": ["string", "null"] },
        "separable": { "$ref": "#/$defs/separable" },
        "parts": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "minItems": 1
        },
        "audio": { "type": "string", "minLength": 1 }
      }
    }
  }
}
